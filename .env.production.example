# =========================================================
# UnlazyNotes Production Environment Configuration Template
# Duplicate this file to .env on production VPS
# =========================================================

NODE_ENV=production
PORT=4321
HOST=0.0.0.0

# Database Configuration (Docker Compose internal network)
# When running with docker compose, host is 'postgres'
POSTGRES_USER=postgres
POSTGRES_PASSWORD=generate_a_very_secure_password_here
POSTGRES_DB=unlazynotes
DATABASE_URL=postgres://postgres:generate_a_very_secure_password_here@postgres:5432/unlazynotes

# Better Auth Configuration
# Generate 32+ character hex: openssl rand -hex 32
BETTER_AUTH_SECRET=generate_openssl_rand_hex_32_here
BETTER_AUTH_URL=https://unlazynotes.com

# Google OAuth (Obtain from Google Cloud Console -> Credentials)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=your_bot_token_from_botfather
TELEGRAM_WEBHOOK_SECRET=generate_random_secret_token_here

# AI Engine Gateway
AI_BASE_URL=https://api.cosmoshub.tech/v1
AI_PROVIDER_API_KEY=your_cosmoshub_api_key
AI_MODEL_NAME=deepseek-v4.1-flash

# DOKU Hosted Checkout Payment Gateway
# Set real credentials for production, or leave empty/mock- for sandbox simulator
DOKU_CLIENT_ID=MCH-PRODUCTION-CLIENT-ID
DOKU_SHARED_KEY=production_shared_secret_key
DOKU_API_BASE_URL=https://api.doku.com

# Administrator Access
ADMIN_EMAIL=admin@unlazynotes.com
