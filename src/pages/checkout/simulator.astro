---
import Layout from '../../layouts/Layout.astro';

export const prerender = false;

const url = new URL(Astro.request.url);
const orderId = url.searchParams.get('order_id') || 'ORD-UNKNOWN';
const amount = url.searchParams.get('amount') || '49000';
const currency = url.searchParams.get('currency') || 'IDR';
const plan = url.searchParams.get('plan') || 'pro';
const period = url.searchParams.get('period') || 'monthly';
---

<Layout title="DOKU Payment Simulator – UnlazyNotes">
  <div class="min-h-screen bg-canvas text-ink flex items-center justify-center p-4">
    <div class="w-full max-w-lg p-6 sm:p-8 rounded-lg border border-hairline bg-canvas space-y-6">
      <div class="flex items-center justify-between border-b border-hairline pb-4">
        <div class="flex items-center gap-2.5">
          <div class="w-7 h-7 rounded-full bg-primary text-on-primary flex items-center justify-center font-bold text-xs">
            D
          </div>
          <span class="font-semibold text-ink text-body-sm-strong">DOKU Checkout Simulator</span>
        </div>
        <span class="inline-flex items-center px-2 py-0.5 rounded-full bg-surface-soft text-ink font-sans font-medium text-caption-xs">
          Sandbox Mode
        </span>
      </div>

      <div class="space-y-3">
        <div class="p-4 rounded-lg border border-hairline bg-surface-soft space-y-2 text-body-sm">
          <div class="flex justify-between text-body">
            <span>Invoice / Order ID:</span>
            <span class="font-mono text-ink font-semibold" id="val-order-id">{orderId}</span>
          </div>
          <div class="flex justify-between text-body">
            <span>Paket:</span>
            <span class="text-ink font-semibold uppercase">{plan} ({period})</span>
          </div>
          <div class="flex justify-between text-body">
            <span>Total Tagihan:</span>
            <span class="text-ink font-bold text-body-md font-mono tabular-nums">
              {currency === 'USD' ? `$${amount}` : `Rp${Number(amount).toLocaleString('id-ID')}`}
            </span>
          </div>
        </div>

        <div class="p-4 rounded-lg border border-hairline bg-canvas text-body-sm text-body">
          <p class="font-semibold text-ink mb-2">Simulasi Metode Pembayaran:</p>
          <div class="grid grid-cols-2 gap-2">
            <div class="p-2.5 rounded-full border border-hairline bg-surface-soft text-ink font-medium text-center text-caption-sm">
              QRIS / E-Wallet
            </div>
            <div class="p-2.5 rounded-full border border-hairline bg-surface-soft text-ink font-medium text-center text-caption-sm">
              Virtual Account
            </div>
          </div>
        </div>
      </div>

      <!-- Error Message Banner -->
      <div id="sim-error" class="hidden p-3 rounded-xl bg-terminal-red/10 border border-terminal-red/20 text-terminal-red text-caption-sm text-center font-sans">
      </div>

      <!-- Action Buttons -->
      <div class="space-y-3 pt-2">
        <button
          id="btn-pay-success"
          type="button"
          class="w-full h-10 px-5 rounded-full bg-primary hover:bg-ink-deep text-on-primary text-button-md cursor-pointer select-none !border-0"
        >
          Simulasikan Bayar Sukses (Lunas)
        </button>

        <button
          id="btn-pay-fail"
          type="button"
          class="w-full h-10 px-5 rounded-full border border-hairline bg-surface-soft hover:bg-canvas text-body hover:text-ink text-button-md cursor-pointer select-none"
        >
          Batalkan Transaksi
        </button>
      </div>

      <p class="text-caption-sm text-body text-center leading-normal">
        Halaman simulator internal UnlazyNotes untuk menguji integrasi webhook DOKU secara nyata tanpa memotong saldo.
      </p>
    </div>
  </div>

  <script>
    const orderId = document.getElementById('val-order-id')?.textContent || '';

    const btnSuccess = document.getElementById('btn-pay-success');
    if (btnSuccess) {
      btnSuccess.addEventListener('click', async () => {
        btnSuccess.setAttribute('disabled', 'true');
        btnSuccess.textContent = 'Memproses Webhook...';
        const errEl = document.getElementById('sim-error');
        if (errEl) errEl.classList.add('hidden');

        try {
          const res = await fetch('/api/payment/webhook', {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json',
              'X-Payment-Simulator': 'true',
            },
            body: JSON.stringify({
              order: { invoice_number: orderId },
              transaction: { status: 'SUCCESS' },
            }),
          });

          if (res.ok) {
            window.location.href = '/dashboard/settings?payment=success';
          } else {
            if (errEl) {
              errEl.textContent = 'Gagal memproses webhook pembayaran';
              errEl.classList.remove('hidden');
            }
            btnSuccess.removeAttribute('disabled');
            btnSuccess.textContent = 'Simulasikan Bayar Sukses (Lunas)';
          }
        } catch {
          if (errEl) {
            errEl.textContent = 'Terjadi kesalahan jaringan saat memproses webhook';
            errEl.classList.remove('hidden');
          }
          btnSuccess.removeAttribute('disabled');
          btnSuccess.textContent = 'Simulasikan Bayar Sukses (Lunas)';
        }
      });
    }

    const btnFail = document.getElementById('btn-pay-fail');
    if (btnFail) {
      btnFail.addEventListener('click', () => {
        window.location.href = '/dashboard/settings?payment=cancelled';
      });
    }
  </script>
</Layout>
