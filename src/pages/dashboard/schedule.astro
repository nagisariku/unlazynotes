---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/dashboard/Sidebar';
import ScheduleView from '../../components/dashboard/ScheduleView';
import { getSessionUser } from '../../lib/session';
import { db } from '../../db';
import { notes, users, apiKeys } from '../../db/schema';
import { eq, and, desc } from 'drizzle-orm';

export const prerender = false;

const user = await getSessionUser(Astro.request);
if (!user) {
  return Astro.redirect('/login');
}

const [userRecord] = await db
  .select({ tier: users.tier })
  .from(users)
  .where(eq(users.id, user.id))
  .limit(1);

const [apiKeyRecord] = await db
  .select()
  .from(apiKeys)
  .where(eq(apiKeys.userId, user.id))
  .limit(1);

// Default safe query limit untuk initial load (arsitektur siap disambungkan ke infinite scroll saat volume catatan bertumbuh pesat)
const DEFAULT_PAGE_LIMIT = 100;

const scheduleNotes = await db
  .select()
  .from(notes)
  .where(
    and(
      eq(notes.userId, user.id),
      eq(notes.category, 'schedule')
    )
  )
  .orderBy(desc(notes.isPinned), desc(notes.createdAt))
  .limit(DEFAULT_PAGE_LIMIT);

const serializedItems = scheduleNotes.map((n) => ({
  id: n.id,
  content: n.content,
  category: n.category,
  specificTags: n.specificTags,
  source: n.source,
  isPinned: n.isPinned,
  isProcessed: n.isProcessed,
  targetDate: n.targetDate ? n.targetDate.toISOString() : null,
  schedule: n.schedule,
  scheduleDates: n.scheduleDates,
  expenses: n.expenses,
  income: n.income,
  debt: n.debt,
  attachments: n.attachments,
  createdAt: n.createdAt.toISOString(),
}));
---

<Layout title="Schedule – UnlazyNotes">
  <div class="flex flex-col md:flex-row h-screen h-[100dvh] bg-canvas text-ink overflow-hidden">
    <Sidebar
      client:load
      currentPath="/dashboard/schedule"
      user={user}
      subscriptionPlan={userRecord?.tier || 'free'}
      isTelegramConnected={Boolean(apiKeyRecord?.telegramChatId)}
      rawApiKey={apiKeyRecord?.rawKey || null}
    />
    <main class="flex-1 min-w-0 min-h-0 overflow-y-auto overflow-x-hidden">
      <ScheduleView
        client:load
        initialItems={serializedItems}
        userName={user.name || user.email.split('@')[0]}
      />
    </main>
  </div>
</Layout>
