---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/dashboard/Sidebar';
import BookmarksView from '../../components/dashboard/BookmarksView';
import { getSessionUser } from '../../lib/session';
import { db } from '../../db';
import { notes, users, apiKeys } from '../../db/schema';
import { eq, and, desc } from 'drizzle-orm';

export const prerender = false;

const user = await getSessionUser(Astro.request);
if (!user) {
  return Astro.redirect('/login');
}

const [userRecord] = await db
  .select({ tier: users.tier })
  .from(users)
  .where(eq(users.id, user.id))
  .limit(1);

const [apiKeyRecord] = await db
  .select()
  .from(apiKeys)
  .where(eq(apiKeys.userId, user.id))
  .limit(1);

// Default safe query limit untuk initial load (arsitektur siap disambungkan ke infinite scroll saat volume catatan bertumbuh pesat)
const DEFAULT_PAGE_LIMIT = 100;

const bookmarkNotes = await db
  .select()
  .from(notes)
  .where(and(eq(notes.userId, user.id), eq(notes.category, 'bookmark')))
  .orderBy(desc(notes.isPinned), desc(notes.createdAt))
  .limit(DEFAULT_PAGE_LIMIT);

const serializedBookmarks = bookmarkNotes.map((b) => ({
  id: b.id,
  content: b.content,
  category: b.category,
  bookmarkType: b.bookmarkType,
  bookmarkMeta: b.bookmarkMeta,
  specificTags: b.specificTags,
  source: b.source,
  isPinned: b.isPinned,
  attachments: b.attachments,
  createdAt: b.createdAt.toISOString(),
}));
---

<Layout title="Bookmarks – UnlazyNotes">
  <div class="flex flex-col md:flex-row h-screen h-[100dvh] bg-canvas text-ink overflow-hidden">
    <Sidebar
      client:load
      currentPath="/dashboard/bookmarks"
      user={user}
      subscriptionPlan={userRecord?.tier || 'free'}
      isTelegramConnected={Boolean(apiKeyRecord?.telegramChatId)}
      rawApiKey={apiKeyRecord?.rawKey || null}
    />
    <main class="flex-1 min-w-0 min-h-0 overflow-y-auto overflow-x-clip [touch-action:pan-y]">
      <BookmarksView
        client:load
        initialBookmarks={serializedBookmarks}
        userName={user.name || user.email.split('@')[0]}
      />
    </main>
  </div>
</Layout>
