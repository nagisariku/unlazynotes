---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/dashboard/Sidebar';
import NotesTimeline from '../../components/dashboard/NotesTimeline';
import { getSessionUser } from '../../lib/session';
import { db } from '../../db';
import { notes, users } from '../../db/schema';
import { eq, desc } from 'drizzle-orm';

export const prerender = false;

const user = await getSessionUser(Astro.request);
if (!user) {
  return Astro.redirect('/login');
}

const [userRecord] = await db
  .select({ tier: users.tier })
  .from(users)
  .where(eq(users.id, user.id))
  .limit(1);

const userNotes = await db
  .select()
  .from(notes)
  .where(eq(notes.userId, user.id))
  .orderBy(desc(notes.createdAt));

const serializedNotes = userNotes.map((n) => ({
  id: n.id,
  content: n.content,
  category: n.category,
  specificTags: n.specificTags,
  source: n.source,
  isEncrypted: n.isEncrypted,
  vaultKey: n.vaultKey,
  createdAt: n.createdAt.toISOString(),
}));
---

<Layout title="Notes – UnlazyNotes">
  <div class="flex flex-col md:flex-row min-h-screen bg-zinc-950">
    <Sidebar client:load currentPath="/dashboard" user={user} subscriptionPlan={userRecord?.tier || 'free'} />
    <main class="flex-1 min-w-0 pb-24 md:pb-8 overflow-y-auto">
      <NotesTimeline client:load initialNotes={serializedNotes} />
    </main>
  </div>
</Layout>
