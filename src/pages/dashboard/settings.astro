---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/dashboard/Sidebar';
import SettingsView from '../../components/dashboard/SettingsView';
import { getSessionUser } from '../../lib/session';
import { db } from '../../db';
import { subscriptions, apiKeys } from '../../db/schema';
import { eq } from 'drizzle-orm';
import { ensureUserInitialResources } from '../../lib/auth';

export const prerender = false;

const user = await getSessionUser(Astro.request);
if (!user) {
  return Astro.redirect('/login');
}

// Pastikan user memiliki subscription dan API Key
await ensureUserInitialResources(user.id, user.preferredLocale);

const [sub] = await db
  .select()
  .from(subscriptions)
  .where(eq(subscriptions.userId, user.id))
  .limit(1);

const [keyRecord] = await db
  .select()
  .from(apiKeys)
  .where(eq(apiKeys.userId, user.id))
  .limit(1);

const serializedSub = sub
  ? {
      plan: sub.plan,
      status: sub.status,
      currency: sub.currency,
      notesTodayCount: sub.notesTodayCount,
      expiresAt: sub.expiresAt ? sub.expiresAt.toISOString() : null,
    }
  : null;

const apiKeyInfo = {
  rawKey: null, // key asli di-hash di DB; saat regenerate akan memunculkan raw key baru
  telegramChatId: keyRecord?.telegramChatId || null,
  isActive: keyRecord?.isActive ?? true,
};
---

<Layout title="Settings – UnlazyNotes">
  <div class="flex min-h-screen bg-zinc-950">
    <Sidebar client:load currentPath="/dashboard/settings" user={user} subscriptionPlan={serializedSub?.plan || 'standard'} />
    <main class="flex-1 min-w-0 overflow-y-auto">
      <SettingsView
        client:load
        user={user}
        subscription={serializedSub}
        apiKeyInfo={apiKeyInfo}
      />
    </main>
  </div>
</Layout>
