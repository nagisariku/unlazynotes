---
import Layout from '../../layouts/Layout.astro';
import Sidebar from '../../components/dashboard/Sidebar';
import SettingsView from '../../components/dashboard/SettingsView';
import { getSessionUser } from '../../lib/session';
import { db } from '../../db';
import { subscriptions, apiKeys, users } from '../../db/schema';
import { eq } from 'drizzle-orm';
import { ensureUserInitialResources } from '../../lib/auth';
import { checkUserQuotaAndTier } from '../../lib/quota-service';

export const prerender = false;

const user = await getSessionUser(Astro.request);
if (!user) {
  return Astro.redirect('/login');
}

// Pastikan user memiliki subscription dan API Key
await ensureUserInitialResources(user.id, user.preferredLocale);
const quotaInfo = await checkUserQuotaAndTier(user.id);

const [userRecord] = await db
  .select()
  .from(users)
  .where(eq(users.id, user.id))
  .limit(1);

const [sub] = await db
  .select()
  .from(subscriptions)
  .where(eq(subscriptions.userId, user.id))
  .limit(1);

const [keyRecord] = await db
  .select()
  .from(apiKeys)
  .where(eq(apiKeys.userId, user.id))
  .limit(1);

const serializedSub = {
  plan: quotaInfo.tier,
  status: quotaInfo.isPro ? 'active' : 'free',
  currency: sub?.currency || 'IDR',
  notesTodayCount: quotaInfo.currentCount,
  expiresAt: userRecord?.proExpiresAt
    ? userRecord.proExpiresAt.toISOString()
    : sub?.expiresAt
    ? sub.expiresAt.toISOString()
    : null,
};

const apiKeyInfo = {
  rawKey: keyRecord?.rawKey || null,
  telegramChatId: keyRecord?.telegramChatId || null,
  isActive: keyRecord?.isActive ?? true,
};
---

<Layout title="Settings – UnlazyNotes">
  <div class="flex flex-col md:flex-row min-h-screen bg-zinc-950">
    <Sidebar client:load currentPath="/dashboard/settings" user={user} subscriptionPlan={serializedSub.plan} />
    <main class="flex-1 min-w-0 pb-24 md:pb-8 overflow-y-auto">
      <SettingsView
        client:load
        user={user}
        subscription={serializedSub}
        apiKeyInfo={apiKeyInfo}
      />
    </main>
  </div>
</Layout>
