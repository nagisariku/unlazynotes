---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'UnlazyNotes – Organize Thoughts Instantly via Telegram',
  description = 'Solusi praktis mencatat ide, to-do list, tautan, dan draf langsung dari obrolan Telegram ke web dashboard terstruktur rapi.',
} = Astro.props;
---

<!doctype html>
<html lang="id">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Tangerine:wght@400;700&display=swap" rel="stylesheet">
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="min-h-screen antialiased bg-canvas text-ink selection:bg-primary selection:text-on-primary font-sans">
    <slot />
  </body>
</html>
