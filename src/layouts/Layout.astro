---
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'UnlazyNotes – Organize Thoughts Instantly via Telegram',
  description = 'Solusi praktis mencatat ide, to-do list, tautan, dan draf langsung dari obrolan Telegram ke web dashboard terstruktur rapi.',
} = Astro.props;
---

<!doctype html>
<html lang="id" class="dark">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <title>{title}</title>
    <meta name="description" content={description} />
  </head>
  <body class="bg-zinc-950 text-zinc-100 min-h-screen selection:bg-indigo-500/30 selection:text-indigo-200 antialiased">
    <slot />
  </body>
</html>
