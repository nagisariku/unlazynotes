# ========================================================
# UnlazyNotes Environment Configuration Template
# Duplicate this file to .env and configure your values
# ========================================================

PORT=4321
HOST=0.0.0.0
NODE_ENV=development

# Database Configuration (PostgreSQL)
DATABASE_URL=postgres://postgres:password@localhost:5432/unlazynotes_dev

# Better Auth Configuration
# Generate 32+ character hex: openssl rand -hex 32
BETTER_AUTH_SECRET=super_secret_better_auth_token_at_least_32_chars_long
BETTER_AUTH_URL=http://localhost:4321

# Google OAuth Credentials (Optional in local dev, mock fallback supported)
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-your_google_client_secret

# Telegram Bot Integration
TELEGRAM_BOT_TOKEN=123456789:ABCdefGhIJKlmNoPQRstuVWXyz
TELEGRAM_WEBHOOK_SECRET=super_secret_webhook_token_123

# AI Provider Gateway (OpenAI-compatible / Cosmoshub / DeepSeek)
AI_BASE_URL=https://api.cosmoshub.tech/v1
AI_PROVIDER_API_KEY=sk-placeholder-key
AI_MODEL_NAME=deepseek-v4.1-flash

# DOKU Hosted Checkout Payment Gateway
# Set real credentials for production, or leave placeholder for sandbox simulator
DOKU_CLIENT_ID=MCH-DEV-TEST-ID
DOKU_SHARED_KEY=dev_shared_secret_key
DOKU_API_BASE_URL=https://api-sandbox.doku.com

# Administrator Access
ADMIN_EMAIL=admin@unlazynotes.local
