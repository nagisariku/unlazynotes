{
  "name": "UnlazyNotes",
  "short_name": "UnlazyNotes",
  "description": "Organize Thoughts Instantly via Telegram and Web",
  "start_url": "/dashboard",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#000000",
  "icons": [
    {
      "src": "/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml"
    }
  ],
  "share_target": {
    "action": "/dashboard/bookmarks",
    "method": "GET",
    "params": {
      "title": "title",
      "text": "text",
      "url": "new_url"
    }
  }
}
